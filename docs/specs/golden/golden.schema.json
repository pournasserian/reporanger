{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Status: Proposed · Last updated: 2026-09-19",
  "title": "RepoRanger golden samples and fixture expectations",
  "description": "The shape, after parsing from TOML (ADR 0017), of golden/<language>.toml (golden_sample), the fixture's expected counts (expected_counts), and the fixture's history script (history_script). fixture/README.md explains how they are used.",

  "$defs": {
    "edge": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "minLength": 1, "description": "Symbol ID of the source." },
        "target": { "type": "string", "minLength": 1, "description": "Symbol ID of the target; ext: for an external symbol." },
        "line": { "type": "integer", "minimum": 1, "description": "The first site, in the file that establishes the edge." },
        "type": { "enum": ["CALLS", "REFERENCES", "INHERITS", "IMPLEMENTS"] },
        "resolution": { "enum": ["resolved", "import-scoped", "name-match"] },
        "note": { "type": "string" }
      },
      "required": ["source", "target", "line", "type", "resolution"],
      "additionalProperties": false
    },

    "labelled_edge": {
      "type": "object",
      "description": "An edge the extractor produced on a demo repository, judged by a person.",
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["CALLS", "REFERENCES", "INHERITS", "IMPLEMENTS"] },
        "resolution": { "enum": ["resolved", "import-scoped", "name-match"] },
        "correct": { "type": "boolean" },
        "checked_by": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["source", "target", "line", "type", "resolution", "correct"],
      "additionalProperties": false
    },

    "golden_sample": {
      "type": "object",
      "description": "One language's accuracy oracle: complete truth on the fixture, and a judged sample from a demo repository.",
      "properties": {
        "version": { "const": 1 },
        "language": { "type": "string", "minLength": 1 },
        "fixture": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1, "description": "The fixture project this covers." },
            "min_precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "min_recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "filled_by": { "type": "string", "description": "The task spec that fills edges." },
            "edges": {
              "type": "array",
              "description": "Every code edge the fixture should produce, checked by hand. At least 30 of them are CALLS.",
              "items": { "$ref": "#/$defs/edge" }
            },
            "absent": {
              "type": "array",
              "description": "Edges that must not appear, such as a name-match guess the fallback should not make.",
              "items": { "$ref": "#/$defs/edge" }
            }
          },
          "required": ["path", "min_precision", "min_recall", "edges"],
          "additionalProperties": false
        },
        "demo": {
          "type": "object",
          "description": "The release check: sample extracted call edges at a fixed seed, judge each, and measure precision.",
          "properties": {
            "repo": { "type": "string", "minLength": 1 },
            "commit": { "type": ["string", "null"] },
            "sample_seed": { "type": "integer" },
            "sample_size": { "type": "integer", "minimum": 1 },
            "min_precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "filled_by": { "type": "string" },
            "edges": { "type": "array", "items": { "$ref": "#/$defs/labelled_edge" } }
          },
          "required": ["repo", "commit", "sample_seed", "sample_size", "min_precision", "edges"],
          "additionalProperties": false
        }
      },
      "required": ["version", "language", "fixture", "demo"],
      "additionalProperties": false
    },

    "expected_counts": {
      "type": "object",
      "description": "The fixture's known counts, which the CI job compares against a fresh index.",
      "properties": {
        "version": { "const": 1 },
        "language": { "type": "string", "minLength": 1 },
        "files": { "type": "object", "description": "By extraction status.", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "symbols": { "type": "object", "description": "By fine kind.", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "edges": {
          "type": "object",
          "description": "By edge type, then resolution level.",
          "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
        },
        "diagnostics": { "type": "object", "description": "By code.", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "required": ["version", "language", "files", "symbols", "edges", "diagnostics"],
      "additionalProperties": false
    },

    "history_script": {
      "type": "object",
      "description": "The commits a test replays into a temporary git repository, so history facts are known and stable.",
      "properties": {
        "version": { "const": 1 },
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "message": { "type": "string", "minLength": 1 },
              "author": { "type": "string", "minLength": 1, "description": "Name <email>." },
              "date": { "type": "string", "minLength": 1, "description": "ISO 8601 with an offset, as a string." },
              "add": { "type": "array", "items": { "type": "string" }, "description": "Fixture-relative paths to add or update." },
              "delete": { "type": "array", "items": { "type": "string" } },
              "rename": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "from": { "type": "string" }, "to": { "type": "string" } },
                  "required": ["from", "to"],
                  "additionalProperties": false
                }
              },
              "tag": { "type": "string" }
            },
            "required": ["message", "author", "date"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version", "commits"],
      "additionalProperties": false
    }
  }
}
