{
  "$comment": "Status: Proposed · Last updated: 2026-09-19",
  "name": "get_impact",
  "title": "Impact of a change",
  "description": "What a change to the targets could affect (upstream: transitive callers, referrers, and callers through interfaces the targets implement) or what the targets rely on (downstream). The targets form one change set, and depth is the distance from the nearest one. Results are ordered by depth, then importance, then id, and capped by limit: traversal stops after the level that reaches the limit, levels gives exact counts for finished levels, and truncated says the rest wasn't explored. Each item's resolution is the weakest link on the path that reached it. A widely used symbol can reach a third of the code at depth 3, so narrow with edge_types or min_resolution rather than paging through everything.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "minLength": 1,
        "description": "Registered repository name. Optional: defaults to the repository that contains the server's working directory, or the only registered one."
      },
      "targets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": { "type": "string", "minLength": 1 },
        "description": "Symbol or file IDs, or path:line locators: one change set."
      },
      "direction": { "type": "string", "enum": ["upstream", "downstream"], "default": "upstream" },
      "depth": { "type": "integer", "minimum": 1, "maximum": 6, "default": 3 },
      "edge_types": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["CALLS", "REFERENCES", "INHERITS", "IMPLEMENTS"] },
        "default": ["CALLS", "REFERENCES", "INHERITS", "IMPLEMENTS"]
      },
      "min_resolution": {
        "type": "string",
        "enum": ["resolved", "import-scoped", "name-match"],
        "default": "name-match",
        "description": "The weakest resolution level to follow."
      },
      "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
      "cursor": { "type": "string", "minLength": 1, "description": "next_cursor from the previous page; keep the other arguments the same." },
      "include": {
        "type": "array",
        "items": { "enum": ["files", "tests"] },
        "uniqueItems": true,
        "default": [],
        "description": "files: affected nodes grouped by file. tests: test symbols among the affected nodes or mapped to them."
      }
    },
    "required": ["targets"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "node": { "$ref": "../mcp-meta.json#/$defs/node" },
            "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
            "via": { "$ref": "../mcp-meta.json#/$defs/edge_type" },
            "resolution": { "$ref": "../mcp-meta.json#/$defs/resolution" },
            "pending": { "const": true, "description": "Present when an edge on the path awaits SCIP re-resolution." }
          },
          "required": ["node", "depth", "via", "resolution"],
          "additionalProperties": false
        }
      },
      "levels": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
            "count": { "type": "integer", "minimum": 0 },
            "complete": { "type": "boolean", "description": "Whether the traversal finished this level." }
          },
          "required": ["depth", "count", "complete"],
          "additionalProperties": false
        }
      },
      "files": {
        "type": "array",
        "description": "Most affected nodes first.",
        "items": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 }
          },
          "required": ["path", "count"],
          "additionalProperties": false
        }
      },
      "tests": {
        "type": "array",
        "description": "Tests that are affected nodes or map to one; depth is that node's depth.",
        "items": {
          "type": "object",
          "properties": {
            "node": { "$ref": "../mcp-meta.json#/$defs/node" },
            "depth": { "type": "integer", "minimum": 1, "maximum": 6 }
          },
          "required": ["node", "depth"],
          "additionalProperties": false
        }
      },
      "errors": { "$ref": "../mcp-meta.json#/$defs/target_errors" },
      "next_cursor": { "$ref": "../mcp-meta.json#/$defs/next_cursor" },
      "truncated": { "$ref": "../mcp-meta.json#/$defs/truncated" },
      "_meta": { "$ref": "../mcp-meta.json#/$defs/meta" }
    },
    "required": ["items", "levels", "_meta"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}
